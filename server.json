{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.yarenty/emperor-folder",
  "title": "emperor-folder",
  "description": "List, read, search and (opt-in) write, edit and move files inside one folder, never outside it.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/yarenty/emperor-folder",
    "source": "github"
  },
  "websiteUrl": "https://github.com/yarenty/emperor-folder",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "emperor-folder",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve",
          "valueHint": "serve",
          "description": "Run the MCP server."
        },
        {
          "type": "positional",
          "value": "--stdio",
          "valueHint": "stdio",
          "description": "Speak MCP over stdin/stdout."
        },
        {
          "type": "named",
          "name": "--root",
          "description": "The folder the server is confined to. Repeat for several roots; NAME=DIR names one.",
          "isRequired": true,
          "isRepeated": true,
          "format": "filepath",
          "placeholder": "/path/to/folder"
        },
        {
          "type": "named",
          "name": "--writable",
          "description": "Switch without a value: also offer the write, edit and move tools (default: read-only).",
          "isRequired": false,
          "format": "boolean"
        }
      ]
    }
  ]
}
